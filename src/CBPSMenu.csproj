<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>CBPSMenu.net</AssemblyName>
    <RootNamespace>CBPSMenu</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../dist/</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Server\**" />
    <Compile Remove="CBPSMenu.Server\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CitizenFX.Core.Client" Version="1.0.7031" />
    <PackageReference Include="LemonUI.FiveM" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="cp &quot;$(TargetDir)$(TargetName).dll&quot; &quot;$(ProjectDir)../$(TargetName).dll&quot;" />
    <Exec Command="cp &quot;$(TargetDir)Newtonsoft.Json.dll&quot; &quot;$(ProjectDir)../Newtonsoft.Json.dll&quot;" />
    <Exec Command="cp &quot;$(TargetDir)LemonUI.FiveM.dll&quot; &quot;$(ProjectDir)../LemonUI.FiveM.dll&quot;" />
  </Target>

</Project>
