<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <AssemblyName>CBPSMenu.net</AssemblyName>
    <OutputType>Library</OutputType>
    <OutputPath>../dist/Client/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CBPSMenu.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CitizenFX.Core.Client" Version="1.0.10230" />
    <PackageReference Include="LemonUI.FiveM" Version="2.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>



  <!-- Copy dependencies to dist folder -->
  <Target Name="CopyDependencies" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)LemonUI.FiveM.dll" DestinationFolder="../dist/lib/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)Newtonsoft.Json.dll" DestinationFolder="../dist/lib/" SkipUnchangedFiles="true" />
  </Target>
</Project>
